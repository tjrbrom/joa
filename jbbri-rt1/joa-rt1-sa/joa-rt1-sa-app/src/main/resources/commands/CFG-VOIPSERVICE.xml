<RT1Command name="CFG-VOIPSERVICE">
    <validation enabled="true">
        <tid regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <aid>
            <group>
                <attribute name="OLTID" regexpr="^.{1,255}$" required="true" />
                <attribute name="PONID" regexpr="^((NA|[1-9]|[1-9][0-9])-){2}([1-9]|[1-9][0-9])-([1-9]|[1-9][0-9])$" required="true" />
                <attribute name="ONUIDTYPE" regexpr="^(LOID|MAC|PASSWORD|ONU_NUMBER)$" required="true" />
                <attribute name="ONUID" regexpr="^[A-Za-z0-9-_]{0,64}$" required="true" />
                <attribute name="ONUPORT" regexpr="^((NA|1)-){2}(NA|[0-9])-([1-9]|[1-3][0-9]|4[0-8])$" required="true" />
            </group>
            <group>
                <attribute name="ONUIP" regexpr="^.{1,255}$" required="true" />
                <attribute name="ONUPORT" regexpr="^((NA|1)-){2}(NA|[0-9])-([1-9]|[1-3][0-9]|4[0-8])$" required="true" />
            </group>
        </aid>
        <ctag regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <param>
            <block>
                <attribute name="SIPREGDM" regexpr="^.{0,32}$" required="false" />
                <attribute name="SIPUSERNAME" regexpr="^.{0,32}$" required="false" />
                <attribute name="SIPUSERPWD" regexpr="^.{0,32}$" required="false" />
                <attribute name="PHONENUMBER" regexpr="^.{0,32}$" required="true" />
                <attribute name="SVLAN" regexpr="^(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])$" required="false" />
	        <attribute name="VOIPVLAN" regexpr="^(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])$" required="false" />
                <attribute name="IPMODE" regexpr="^(DHCP|STATIC)$" required="false" />
                <attribute name="IP" regexpr="^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$" required="false" />
                <attribute name="IPMASK" regexpr="^(?:255\.(?:255\.(?:255\.(?:255|254|252|248|240|224|192|128|0)|255|254|252|248|240|224|192|128|0)|255|254|252|248|240|224|192|128|0)|255|254|252|248|240|224|192|128|0|0)$" required="false" />
                <attribute name="IPGATEWAY" regexpr="^.{0,32}$" required="false" />
            </block>
        </param>
    </validation>

    <parser id="COMMON.parser"/>

    <handlers>
        <handler id="generalNetconfHandler"/>
    </handlers>

    <outputMsgBuilder id="COMMON.outputMsgBuilder"/>

</RT1Command>
