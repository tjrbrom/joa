<RT1Command name="CFG-ONUBW">
    <validation enabled="true">
        <tid regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <aid>
            <group>
                <attribute name="OLTID" regexpr="^.{1,255}$" required="true" />
                <attribute name="PONID" regexpr="^((NA|[1-9]|[1-9][0-9])-){2}([1-9]|[1-9][0-9])-([1-9]|[1-9][0-9])$" required="true" />
                <attribute name="ONUIDTYPE" regexpr="^(LOID|MAC|PASSWORD|ONU_NUMBER)$" required="true" />
                <attribute name="ONUID" regexpr="^[A-Za-z0-9-_]{0,64}$" required="true" />
            </group>
            <group>
                <attribute name="ONUIP" regexpr="^.{1,255}$" required="true" />
            </group>
        </aid>
        <ctag regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <param>
            <block>
                <attribute name="UPBW" regexpr="^[A-Za-z0-9-_]{0,32}$" required="true" />
                <attribute name="DOWNBW" regexpr="^[A-Za-z0-9-_]{0,32}$" required="false" />
            </block>
        </param>
    </validation>

    <parser id="COMMON.parser"/>

    <handlers>
        <handler id="generalNetconfHandler"/>
    </handlers>

    <outputMsgBuilder id="COMMON.outputMsgBuilder"/>

</RT1Command>