<RT1Command name="ADD-VLAN">
    <validation enabled="true">
        <tid regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <aid>
            <group>
                <attribute name="OLTID" regexpr="^.{1,255}$" required="true" />
            </group>
            <group>
                <attribute name="ONUIP" regexpr="^.{1,255}$" required="true" />
            </group>
        </aid>
        <ctag regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <param>
            <block>
                <attribute name="VLAN" regexpr="^(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5])$" required="true" />
                <attribute name="PORTLIST" regexpr="^(?:NA-NA-NTIO[12]-[1-2][1-4]|NA-NA-NA-LAG1|NA-NA-NA-LAG10)(?:\|(?:NA-NA-NTIO[12]-[1-2][1-4]|NA-NA-NA-LAG1|NA-NA-NA-LAG10))*$" required="false" />
                <attribute name="SERVICE" regexpr="^(HSI|IPTV|VOIP)$" required="true" />
            </block>
        </param>
    </validation>

    <parser id="COMMON.parser"/>

    <handlers>
        <handler id="generalNetconfHandler"/>
    </handlers>

    <outputMsgBuilder id="COMMON.outputMsgBuilder"/>

</RT1Command>