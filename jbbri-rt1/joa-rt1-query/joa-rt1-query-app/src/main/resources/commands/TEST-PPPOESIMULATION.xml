<RT1Command name="TEST-PPPOESIMULATION">
    <validation enabled="true">
        <tid regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <aid>
          <group>
            <attribute name="OLTID" regexpr="^.{1,255}$" required="true" />
            <attribute name="PONID" regexpr="^((NA|[1-9]|[1-9][0-9])-){2}([1-9]|[1-9][0-9])-([1-9]|[1-9][0-9])$" required="true" />
            <attribute name="ONUIDTYPE" regexpr="^(LOID|MAC|PASSWORD|ONU_NUMBER)$" required="true" />
            <attribute name="ONUID" regexpr="^[A-Za-z0-9-_]{0,64}$" required="true" />
            <attribute name="ONUPORT" regexpr="^(NA|1)-(NA|1)-(NA|1)-([1-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$" required="true" />
          </group>
          <group>
			<attribute name="ONUIP" regexpr="^.{1,255}$" required="true" />
            <attribute name="ONUPORT" regexpr="^(NA|1)-(NA|1)-(NA|1)-([1-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$" required="true" />
		  </group>
        </aid>
        <ctag regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <param>
            <block>
                <attribute name="ACTION" regexpr="^(Start|Stop|Query)$" required="true" />
                <attribute name="USERNAME" regexpr="^.{1,64}$" required="true" />
                <attribute name="PASSWORD" regexpr="^.{1,64}$" required="true" />
                <attribute name="VPI" regexpr="^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$" required="false" />
                <attribute name="VCI" regexpr="^(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-9]?[0-9]{0,3})$" required="false" />
                <attribute name="UV" regexpr="^([1-9]|[1-9][0-9]{1,2}|1[0-9]{3}|2[0-9]{3}|3[0-9]{3}|40[0-8][0-9]|409[0-4])$" required="false" />
                <attribute name="AUTHMODE" regexpr="^(AUTO|CHAP|PAP)$" required="false" />
                <attribute name="TIMEOUT" regexpr="^(0|[1-9][0-9]?|1[0-9]{2}|2[0-9]{2}|300)$" required="false" />
            </block>
        </param>
    </validation>

    <parser id="COMMON.parser"/>

    <handlers>
        <handler id="PASS-THROUGH"/>
    </handlers>

    <outputMsgBuilder id="COMMON.outputMsgBuilder"/>

</RT1Command>