<RT1Command name="LST-ONU">
    <validation enabled="true">
        <tid regexpr="^[A-Za-z0-9-_]+$" required="false" />
        <aid>
            <group>
                <attribute name="OLTID" regexpr="^.{1,255}$" required="true" />
                <attribute name="PONID" regexpr="^((NA|[1-9]|[1-9][0-9])-){2}([1-9]|[1-9][0-9])-([1-9]|[1-9][0-9])$" required="false" />
                <attribute name="ONUIDTYPE" regexpr="^(LOID|MAC|PASSWORD|ONU_NUMBER)$" required="false" />
                <attribute name="ONUID" regexpr="^[A-Za-z0-9-_]{0,64}$" required="false" />
            </group>
            <group>
				<attribute name="ONUIP" regexpr="^.{1,255}$" required="true" />
		    </group>
        </aid>
        <ctag regexpr="^[A-Za-z0-9-_]+$" required="false" />
    </validation>

    <parser id="COMMON.parser"/>

    <handlers>
        <handler id="LST-ONU"/>
    </handlers>

    <outputMsgBuilder id="COMMON.outputMsgBuilder"/>

</RT1Command>